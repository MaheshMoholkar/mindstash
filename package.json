  ],
  "author": "Mahesh Moholkar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaheshMoholkar/mindstash.git"
  },
  "homepage": "https://github.com/MaheshMoholkar/mindstash#readme",
